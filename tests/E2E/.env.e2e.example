# End-to-end test environment for the laraclaw package.
#
# Copy this file to tests/E2E/.env.e2e and fill in real credentials. The .env.e2e
# file is gitignored; the .example template is committed so contributors know
# which vars are needed.
#
# Run the suite with: composer test:e2e
# (skipped by default; never runs in CI)

# ---- AI providers -----------------------------------------------------------

# Defaults; can be overridden per call. The package selects 'anthropic' for chat
# because OpenAI's strict mode rejects schemas with optional fields.
AI_DEFAULT=anthropic
AI_DEFAULT_FOR_EMBEDDINGS=openai
AI_DEFAULT_FOR_AUDIO=openai

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Override the audio model if your OpenAI key doesn't have gpt-4o-mini-tts.
# tts-1-hd works with most legacy keys.
OPENAI_AUDIO_MODEL=tts-1-hd

# ---- Laraclaw core ----------------------------------------------------------

LARACLAW_API_ENABLED=true
LARACLAW_API_TOKEN_HASH=
LARACLAW_MEMORY_ENABLED=true
LARACLAW_ALLOWED_DISKS=laraclaw_files
LARACLAW_ATTACHMENTS_DISK=local

# ---- Email (destructive — only used when LARACLAW_E2E_DESTRUCTIVE=1) --------

LARACLAW_EMAIL_ENABLED=true
LARACLAW_SMTP_HOST=
LARACLAW_SMTP_PORT=587
LARACLAW_SMTP_ENCRYPTION=tls
LARACLAW_SMTP_USERNAME=
LARACLAW_SMTP_PASSWORD=
LARACLAW_SMTP_FROM_ADDRESS=
LARACLAW_SMTP_FROM_NAME="Laraclaw E2E"

# Where the EmailManager test sends to.
LARACLAW_E2E_EMAIL_TO=

# ---- Google Calendar (destructive — only used when LARACLAW_E2E_DESTRUCTIVE=1)

LARACLAW_CALENDAR_DRIVER=google
LARACLAW_GOOGLE_CALENDAR_ID=
LARACLAW_GOOGLE_CREDENTIALS_JSON=
LARACLAW_GOOGLE_TOKEN_JSON=

# ---- Flags ------------------------------------------------------------------

# Set to 1 to run tests that send real email or create real Google Calendar
# events. Off by default so re-running the suite stays cheap and quiet.
LARACLAW_E2E_DESTRUCTIVE=0
