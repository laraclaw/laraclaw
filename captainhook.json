{
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "./vendor/bin/rector --no-progress-bar"
            },
            {
                "action": "./vendor/bin/duster fix --dirty"
            },
            {
                "action": "git add -u"
            },
            {
                "action": "./vendor/bin/pest --no-coverage"
            }
        ]
    }
}
