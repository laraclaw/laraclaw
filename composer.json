{
    "$schema": "https://getcomposer.org/schema/json",
    "name": "laraclaw/laraclaw",
    "type": "library",
    "description": "AI-powered chatbot package for Laravel (Telegram, Slack, Email)",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "directorytree/imapengine-laravel": "^1.0",
        "irazasyed/telegram-bot-sdk": "^3.15",
        "laravel/ai": "^0.6.7",
        "laravel/framework": "^12.0|^13.0",
        "league/commonmark": "^2.8",
        "sabre/vobject": "^4.0",
        "spatie/image": "^3.0",
        "spatie/laravel-google-calendar": "^3.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "autoload": {
        "files": [
            "src/Support/Helpers.php"
        ],
        "psr-4": {
            "Laraclaw\\": "src/"
        }
    },
    "suggest": {
        "spatie/pdf-to-text": "Required for PDF text extraction in memory (~^1.0)",
        "thiagoalessio/tesseract_ocr": "Required for image OCR in memory (~^2.0)"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laraclaw\\LaraclawServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "captainhook/plugin-composer": true
        }
    },
    "require-dev": {
        "captainhook/captainhook": "*",
        "captainhook/plugin-composer": "*",
        "driftingly/rector-laravel": "^2.1",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "rector/rector": "^2.3",
        "tightenco/duster": "^3.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Laraclaw\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    }
}
