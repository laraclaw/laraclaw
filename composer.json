{
    "$schema": "https://getcomposer.org/schema/json",
    "name": "laraclaw/laraclaw",
    "type": "library",
    "description": "AI-powered chatbot package for Laravel (Telegram, Slack, Email)",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "directorytree/imapengine-laravel": "^1.0",
        "laravel/ai": "^0.2",
        "laravel/framework": "^12.0",
        "nutgram/laravel": "^1.6",
        "sabre/vobject": "^4.0",
        "spatie/image": "^3.0",
        "spatie/laravel-google-calendar": "^3.0",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "files": [
            "src/Support/Helpers.php"
        ],
        "psr-4": {
            "LaraClaw\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraClaw\\LaraclawServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "tightenco/duster": "^3.3"
    },
    "autoload-dev": {
        "psr-4": {
            "LaraClaw\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    }
}
